GEMMA_MODE=auto                # auto (switch automatique) | api | openrouter | local
GEMINI_API_KEY=                # clé Google AI Studio principale
GEMINI_API_KEYS=               # ou liste de clés Google séparées par des virgules (clé1,clé2)
GEMMA_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEYS=           # liste de clés OpenRouter séparées par des virgules (cléA,cléB)
OPENROUTER_API_KEY=            # ou clé OpenRouter unique
OPENROUTER_MODEL=google/gemma-2-9b-it:free
LOCAL_URL=http://localhost:11434/v1
LOCAL_MODEL=                   # tag exact du petit modèle local (à lire dans Ollama/LM Studio)
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=              # liste d'identifiants Telegram séparés par des virgules
TZ=Africa/Douala
PIPER_BIN=piper
PIPER_VOICE=                   # chemin du modèle de voix française
