{
  "name": "hands-free",
  "version": "0.1.0",
  "description": "Assistant vocal open source d'accessibilité propulsé par Gemma 4 (Telegram & MCP)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "accessibility",
    "voice-assistant",
    "gemma-4",
    "telegram",
    "mcp",
    "hacktoberfest"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "better-sqlite3": "^13.0.3",
    "grammy": "^1.46.0",
    "openai": "^7.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
